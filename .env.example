# Copy to .env and fill in. Never commit .env.

# Shared secret for writes to the ledger (assessments, owner answers).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
MOSCA_LEDGER_TOKEN=

# Comma-separated origins allowed to call the ledger from a browser.
MOSCA_LEDGER_CORS=http://localhost:3000

# Where the website reads the ledger from (server-side only).
LEDGER_URL=http://localhost:8000

# Public repository link shown on the website.
NEXT_PUBLIC_REPO_URL=
